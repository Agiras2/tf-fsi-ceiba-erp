# ============================================================
# CeibaERP - Variables de entorno (EJEMPLO, sin secretos)
# Copie este archivo como .env y complete los valores.
# El archivo .env NUNCA se sube al repositorio.
# ============================================================

# --- Base de datos: Supabase, "Session pooler" (puerto 5432) ---
# Copie el host exacto desde Supabase > Connect > Session pooler.

# Aplicacion y seed: rol de minimo privilegio ceiba_app
DATABASE_URL="postgresql://ceiba_app.REF_PROYECTO:CLAVE_CEIBA_APP@HOST_POOLER:5432/postgres?sslmode=require"

# Migraciones (Prisma CLI): rol prisma. Solo en el equipo del desarrollador, nunca en Railway.
DIRECT_URL="postgresql://prisma.REF_PROYECTO:CLAVE_PRISMA@HOST_POOLER:5432/postgres?sslmode=require"

# --- Base de datos de pruebas: mismo proyecto, esquema "test" ---
DATABASE_URL_TEST="postgresql://ceiba_app.REF_PROYECTO:CLAVE_CEIBA_APP@HOST_POOLER:5432/postgres?sslmode=require&schema=test"
DIRECT_URL_TEST="postgresql://prisma.REF_PROYECTO:CLAVE_PRISMA@HOST_POOLER:5432/postgres?sslmode=require&schema=test"

# --- Sesiones: cadena aleatoria de al menos 32 caracteres ---
JWT_SECRET="CADENA_ALEATORIA_DE_32_O_MAS_CARACTERES"

# --- Inteligencia artificial (Google AI Studio) ---
GEMINI_API_KEY="CLAVE_DE_GOOGLE_AI_STUDIO"
GEMINI_MODEL="gemini-3.8-flash"
# Opcional: otro modelo de Gemini que se usa si el principal esta saturado (503) o sin cuota (429)
GEMINI_MODEL_RESPALDO=""

# --- Datos de demostracion: 10 o mas caracteres con letras y numeros ---
SEED_DEMO_PASSWORD="CONTRASENA_DEMO"

# --- General ---
APP_TIMEZONE="America/Bogota"
