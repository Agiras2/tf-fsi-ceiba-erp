# ============================================================
# CeibaERP - .gitignore
# ============================================================

# --- Variables de entorno y secretos (NUNCA al repositorio) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Dependencias ---
node_modules/
.pnp
.pnp.*
.yarn/*

# --- Next.js / compilacion ---
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# --- Prisma (cliente generado) ---
src/generated/
prisma/generated/

# --- Pruebas y cobertura ---
coverage/
test-results/
playwright-report/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Despliegue ---
.vercel
.railway/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores ---
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Archivos personales / temporales ---
*.zip
capturas/
tmp/
