# Normaliza saltos de linea: LF en el repositorio y en el directorio de trabajo
* text=auto eol=lf

# Scripts de Windows con CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.zip binary
